# Upstream LLM: openai (any OpenAI-compatible API) or mock (deterministic fake, no key needed)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Empty = api.openai.com. See the free presets below.
OPENAI_BASE_URL=
# Client-side pacing for free tiers (requests per minute); 0 = no limit
LLM_MAX_REQUESTS_PER_MINUTE=0
MAX_OUTPUT_TOKENS=300
# USD per million tokens, for cost reporting (check current pricing).
# On a free provider, keep gpt-4o-mini prices to estimate what the same traffic would cost.
PRICE_INPUT_PER_MTOK=0.15
PRICE_OUTPUT_PER_MTOK=0.60

# --- Free OpenAI-compatible presets (uncomment one block, check the provider's current limits) ---
# Groq (free tier, fast):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=openai/gpt-oss-20b
# LLM_MAX_REQUESTS_PER_MINUTE=25
#
# Google Gemini (free tier):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your-gemini-key
# OPENAI_MODEL=gemini-2.0-flash
# LLM_MAX_REQUESTS_PER_MINUTE=10
#
# Ollama (local, free, no key; run `ollama pull llama3.1` first):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1

# Semantic matching
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.72
ENTITY_GUARD_ENABLED=true

# Cache lifecycle
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=10000
